# Included by the generated per-case run.cmake files. Numerical thresholds for
# exact solutions are enforced by stokes itself; these checks cover MPI/output
# integration and the physical pressure/flux conventions of the benchmarks.
cmake_minimum_required(VERSION 3.16)

file(REMOVE_RECURSE "${run_directory}/output")
execute_process(COMMAND ${STOKES_RUN_COMMAND}
  WORKING_DIRECTORY "${run_directory}"
  RESULT_VARIABLE status OUTPUT_VARIABLE stdout ERROR_VARIABLE stderr
  TIMEOUT 150)
file(WRITE "${test_dir}/stdout.log" "${stdout}")
file(WRITE "${test_dir}/stderr.log" "${stderr}")
if(NOT status STREQUAL "0")
  message(FATAL_ERROR "Stokes failed (${status}).\n${stdout}\n${stderr}")
endif()

set(output "${run_directory}/output")
if(NOT EXISTS "${output}/parameters-used.prm" OR
   NOT EXISTS "${output}/summary.csv")
  message(FATAL_ERROR "The run did not write its effective parameters and summary")
endif()
file(STRINGS "${output}/summary.csv" summary)
list(LENGTH summary row_count)
math(EXPR expected_rows "${case_CYCLES} + 1")
if(NOT row_count EQUAL expected_rows)
  message(FATAL_ERROR "Expected ${case_CYCLES} summary cycles, got ${row_count} CSV lines")
endif()
list(GET summary 0 header)
string(REPLACE "," ";" columns "${header}")

function(summary_value row column result)
  list(FIND columns "${column}" index)
  if(index EQUAL -1)
    message(FATAL_ERROR "Summary column ${column} is missing")
  endif()
  string(REPLACE "," ";" values "${row}")
  list(GET values ${index} value)
  set(${result} "${value}" PARENT_SCOPE)
endfunction()

function(check_finite value label)
  if(NOT "${value}" MATCHES "^[+-]?([0-9]+([.][0-9]*)?|[.][0-9]+)([eE][+-]?[0-9]+)?$")
    message(FATAL_ERROR "${label} is not finite: ${value}")
  endif()
endfunction()

set(previous_cells 0)
math(EXPR last_cycle "${case_CYCLES} - 1")
foreach(cycle RANGE ${last_cycle})
  math(EXPR row_index "${cycle} + 1")
  list(GET summary ${row_index} row)
  foreach(column cycle backend problem mpi_ranks cells)
    summary_value("${row}" "${column}" recorded_${column})
  endforeach()
  if(NOT recorded_cycle EQUAL cycle OR
     NOT recorded_backend STREQUAL backend OR
     NOT recorded_problem STREQUAL problem OR
     NOT recorded_mpi_ranks EQUAL ranks)
    message(FATAL_ERROR "Summary does not match the requested case: ${row}")
  endif()
  if(previous_cells GREATER 0)
    math(EXPR expected_cells "4 * ${previous_cells}")
    if(NOT recorded_cells EQUAL expected_cells)
      message(FATAL_ERROR "Uniform refinement did not quadruple the cell count")
    endif()
  endif()
  set(previous_cells "${recorded_cells}")

  foreach(column true_residual relative_true_residual divergence_L2 mean_pressure
      inlet_outward_flux outlet_outward_flux net_outward_flux
      preconditioner_setup_seconds solve_seconds)
    summary_value("${row}" "${column}" value)
    check_finite("${value}" "${column}")
  endforeach()
  summary_value("${row}" net_outward_flux net_flux)
  if(net_flux LESS -1e-7 OR net_flux GREATER 1e-7)
    message(FATAL_ERROR "The net boundary flux exceeds 1e-7: ${net_flux}")
  endif()
  if(problem STREQUAL cavity OR problem STREQUAL colliding)
    summary_value("${row}" mean_pressure pressure_mean)
    if(pressure_mean LESS -1e-8 OR pressure_mean GREATER 1e-8)
      message(FATAL_ERROR "Closed-domain pressure was not normalized to zero mean: ${pressure_mean}")
    endif()
  endif()
  if(problem STREQUAL poiseuille OR problem STREQUAL colliding)
    foreach(column velocity_L2_error velocity_H1_seminorm_error pressure_L2_error)
      summary_value("${row}" "${column}" value)
      check_finite("${value}" "${column}")
    endforeach()
  else()
    foreach(column velocity_L2_error velocity_H1_seminorm_error pressure_L2_error)
      summary_value("${row}" "${column}" value)
      if(NOT value STREQUAL "nan")
        message(FATAL_ERROR "A benchmark without an analytic solution reported ${column}=${value}")
      endif()
    endforeach()
  endif()
  if(problem STREQUAL poiseuille)
    summary_value("${row}" inlet_outward_flux inlet_flux)
    summary_value("${row}" outlet_outward_flux outlet_flux)
    if(inlet_flux LESS -1.33333335 OR inlet_flux GREATER -1.33333331 OR
       outlet_flux LESS 1.33333331 OR outlet_flux GREATER 1.33333335)
      message(FATAL_ERROR "Poiseuille fluxes do not match +/-4/3: ${inlet_flux}, ${outlet_flux}")
    endif()
  endif()

  if(case_CHECK_OUTPUT)
    set(cycle_text "00${cycle}")
    string(LENGTH "${cycle_text}" cycle_length)
    math(EXPR cycle_start "${cycle_length} - 3")
    string(SUBSTRING "${cycle_text}" ${cycle_start} 3 cycle_text)
    set(record "${output}/stokes_${cycle_text}.pvtu")
    set(history "${output}/residuals-${cycle_text}.csv")
    if(NOT EXISTS "${record}" OR NOT EXISTS "${history}")
      message(FATAL_ERROR "Cycle ${cycle} did not produce PVTU and residual-history output")
    endif()
    file(STRINGS "${history}" history_rows)
    list(GET history_rows 0 history_header)
    list(LENGTH history_rows history_count)
    if(NOT history_header STREQUAL "iteration,outer_residual_estimate" OR
       history_count LESS 2)
      message(FATAL_ERROR "Missing residual estimates in ${history}")
    endif()
    file(READ "${record}" pvtu)
    foreach(field velocity pressure)
      if(NOT pvtu MATCHES "Name=\"${field}\"")
        message(FATAL_ERROR "PVTU output is missing the ${field} field")
      endif()
    endforeach()
    string(REGEX MATCHALL "<Piece Source=\"[^\"]+\"" pieces "${pvtu}")
    list(LENGTH pieces piece_count)
    if(NOT piece_count EQUAL ranks)
      message(FATAL_ERROR "PVTU contains ${piece_count} pieces for ${ranks} ranks")
    endif()
    foreach(piece IN LISTS pieces)
      string(REGEX REPLACE "^<Piece Source=\"([^\"]+)\"$" "\\1" filename "${piece}")
      if(NOT EXISTS "${output}/${filename}")
        message(FATAL_ERROR "PVTU references a missing piece: ${filename}")
      endif()
      file(SIZE "${output}/${filename}" piece_size)
      if(piece_size EQUAL 0)
        message(FATAL_ERROR "Empty VTU piece: ${filename}")
      endif()
    endforeach()
  endif()
endforeach()

if(case_CHECK_MULTILEVEL)
  if(NOT stdout MATCHES "Number of levels[ \t]*:[ \t]*([0-9]+)")
    message(FATAL_ERROR "AMG verbosity did not report the constructed hierarchy")
  endif()
  if(CMAKE_MATCH_1 LESS 2)
    message(FATAL_ERROR "The ML test constructed only ${CMAKE_MATCH_1} level")
  endif()
endif()

message(STATUS "Validated ${backend}/${problem}: ${case_CYCLES} cycle(s), ${ranks} rank(s)")
