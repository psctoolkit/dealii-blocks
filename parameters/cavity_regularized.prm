# Example 5.1.3: lid u_x=1-x^4, including zero top-corner values.
subsection Problem
  set Test case = cavity
  set Cavity lid = regularized
end
subsection Discretization
  set Pressure degree = 1
  set Initial global refinements = 3
end
subsection Linear algebra
  set Block preconditioner = diagonal
  subsection Velocity block
    set Action = solve
  end
  subsection Pressure block
    set Action = solve
  end
end
subsection Output
  set Directory = output/cavity_regularized
end
