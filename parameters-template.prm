    subsection PETSc
      # Native PETSc options, e.g. -pc_asm_overlap 1 -sub_pc_type ilu. This
      # private PC options database does not modify other blocks.
      set Options =

      # Native PETSc PC type, for example gamg, hypre, asm, bjacobi, jacobi,
      # ilu, lu or none. Availability follows the PETSc build.
      set pc_type = gamg
    end

    subsection Trilinos
      # deal.II Trilinos preconditioner: AMG, Jacobi, SSOR, ILU, ILUT, IC or
      # Identity.
      set Preconditioner        = AMG

      # ML aggregation threshold.
      set aggregation_threshold = 0.0001

      # ML coarse solver selection.
      set coarse_type           = Amesos-KLU

      # ML higher order finite-element flag.
      set higher_order_elements = true

      # Incomplete factorization diagonal absolute perturbation.
      set ilu_atol              = 0

      # ILU, ILUT or IC fill level.
      set ilu_fill              = 0

      # Incomplete factorization diagonal relative perturbation.
      set ilu_rtol              = 1

      # ILUT dropping threshold.
      set ilut_drop             = 0.001

      # ML cycles per application.
      set n_cycles              = 1

      # Print ML hierarchy details.
      set output_details        = false

      # Jacobi or SSOR damping.
      set relaxation            = 1

      # Ifpack or AMG overlap.
      set smoother_overlap      = 0

      # AMG or relaxation sweeps.
      set smoother_sweeps       = 2

      # ML smoother selection.
      set smoother_type         = symmetric Gauss-Seidel

      # Use ML W cycles.
      set w_cycle               = false
    end

  end

end


subsection Output
  # Relative paths are relative to the process working directory.
  set Directory              = output

  # Print deal.II solver progress on rank zero.
  set Solver trace           = false

  # Write the selected outer solver's residual estimates to CSV.
  set Write residual history = true

  # Write parallel VTU/PVTU files for velocity and pressure.
  set Write visualization    = true
end


subsection Problem
  # leaky: unit top-corner values; watertight: zero corner values;
  # regularized: 1-x^4.
  set Cavity lid               = regularized

  # The step inlet is 4*peak*y*(1-y). The excerpt specifies its shape but not
  # amplitude.
  set Step inlet peak velocity = 1

  # Examples 5.1.1--5.1.4 in the supplied Stokes excerpt, all with zero body
  # force.
  set Test case                = poiseuille

  # Positive constant nu in -nu*Laplacian(u)+grad(p)=0.
  set Viscosity                = 1
end


subsection Verification
  # Negative disables this check. Taylor-Hood is weakly, not pointwise,
  # divergence-free.
  set Maximum divergence L2 norm = -1

  # Negative disables this check; colliding pressure errors are modulo
  # constants.
  set Maximum pressure L2 error  = -1

  # Negative disables this check; available for poiseuille and colliding.
  set Maximum velocity L2 error  = -1
end
